<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>tr('GitHub PRs')</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2016%2016'%20fill='%233fb950'%3E%3Cpath%20d='M1.5%203.25a2.25%202.25%200%201%201%203%202.122v5.256a2.251%202.251%200%201%201-1.5%200V5.372A2.25%202.25%200%200%201%201.5%203.25zm5.677-.177L9.573.677A.25.25%200%200%201%2010%20.854V2.5h1A2.5%202.5%200%200%201%2013.5%205v5.628a2.251%202.251%200%201%201-1.5%200V5a1%201%200%200%200-1-1h-1v1.646a.25.25%200%200%201-.427.177L7.177%203.427a.25.25%200%200%201%200-.354z'/%3E%3C/svg%3E">

  <meta name="x-icue-restrictions" data-restrictions='[{"device":"dashboard_lcd"}]'>
  <meta name="x-icue-interactive">

  <meta name="x-icue-property" content="refreshInterval" data-label="tr('Refresh (min)')" data-type="slider" data-default="3" data-min="1" data-max="30" data-step="1">
  <meta name="x-icue-property" content="showDrafts" data-label="tr('Draft PRs')" data-type="tab-buttons" data-values="['Show','Hide']" data-default="'Show'">

  <meta name="x-icue-property" content="textColor" data-label="tr('Text Color')" data-type="color" data-default="'#e6edf3'">
  <meta name="x-icue-property" content="accentColor" data-label="tr('Accent Color')" data-type="color" data-default="'#58a6ff'">
  <meta name="x-icue-property" content="backgroundColor" data-label="tr('Background')" data-type="color" data-default="'#0d1117'">
  <meta name="x-icue-property" content="transparency" data-label="tr('Transparency')" data-type="slider" data-default="100" data-min="0" data-max="100" data-step="1">

  <script id="x-icue-groups" type="application/json">
  [
    { "title": "tr('GitHub PRs')", "properties": ["refreshInterval", "showDrafts"] },
    { "title": "tr('Widget Personalization')", "properties": ["textColor", "accentColor", "backgroundColor", "transparency"] }
  ]
  </script>

  <style>
    :root {
      --bg-color: #0d1117;
      --surface-color: #161b22;
      --border-color: #30363d;
      --text-primary: #e6edf3;
      --text-secondary: #7d8590;
      --accent-color: #58a6ff;
      --green: #3fb950;
      --red: #f85149;
      --yellow: #d29922;
      --purple: #bc8cff;
      --transparency: 1;
    }
    html { overflow: hidden; }
    body {
      margin: 0; padding: 0;
      width: 100vw; height: 100vh;
      display: flex; align-items: center; justify-content: center;
      background: var(--bg-color);
      color: var(--text-primary);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      font-size: 14px;
      opacity: var(--transparency);
      overflow: hidden;
      -webkit-user-select: none; user-select: none;
    }
    *, *::before, *::after { box-sizing: border-box; }

    /* Loading */
    .loading-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; height: 100vh; width: 100vw; }
    .spinner { width: 32px; height: 32px; border: 3px solid var(--border-color); border-top-color: var(--accent-color); border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .loading-state span { color: var(--text-secondary); font-size: 13px; }

    /* Setup */
    .setup-state { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 16px; height: 100vh; width: 100vw; padding: 24px; }
    .setup-icon { width: 48px; height: 48px; opacity: 0.7; }
    .setup-title { font-size: 18px; font-weight: 600; }
    .setup-hint { font-size: 12px; color: var(--text-secondary); text-align: center; max-width: 320px; line-height: 1.5; }
    .pat-input { width: 100%; max-width: 340px; padding: 10px 12px; background: var(--surface-color); border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-size: 14px; font-family: monospace; outline: none; }
    .pat-input:focus { border-color: var(--accent-color); }
    .pat-input::placeholder { color: var(--text-secondary); }
    .setup-btn { padding: 8px 24px; background: var(--green); color: #fff; font-weight: 600; font-size: 14px; border: none; border-radius: 6px; cursor: pointer; }
    .setup-btn:hover { opacity: 0.9; }
    .setup-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .setup-error { color: var(--red); font-size: 13px; display: none; text-align: center; }

    /* Error */
    .error-state { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 12px; height: 100vh; width: 100vw; padding: 24px; }
    .error-msg { color: var(--text-secondary); font-size: 14px; text-align: center; max-width: 300px; }
    .error-btn { padding: 6px 16px; background: var(--surface-color); border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-size: 13px; cursor: pointer; }
    .error-btn:hover { border-color: var(--accent-color); }

    /* Content */
    .content-area { display: none; flex-direction: column; width: 100vw; height: 100vh; overflow: hidden; }

    /* Header */
    .header-bar { display: flex; align-items: center; padding: 10px 14px; flex-shrink: 0; border-bottom: 1px solid var(--border-color); gap: 10px; }
    .header-title { font-size: 14px; font-weight: 600; flex: 1; }

    /* Tab Bar */
    .tab-bar { display: flex; flex-shrink: 0; border-bottom: 1px solid var(--border-color); background: var(--surface-color); }
    .tab-btn { flex: 1; padding: 8px 4px; text-align: center; font-size: 12px; font-weight: 500; color: var(--text-secondary); cursor: pointer; border: none; background: none; border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s; }
    .tab-btn:hover { color: var(--text-primary); }
    .tab-btn.active { color: var(--text-primary); border-bottom-color: var(--accent-color); }
    .tab-badge { display: inline-block; min-width: 16px; padding: 0 5px; margin-left: 4px; font-size: 10px; font-weight: 600; line-height: 16px; text-align: center; border-radius: 8px; background: var(--border-color); color: var(--text-primary); }

    /* Panel (scrollable list) */
    .panel { display: none; flex: 1; overflow-y: auto; }
    .panel.active { display: block; }

    /* PR Card */
    .pr-card { padding: 10px 14px; border-bottom: 1px solid var(--border-color); }
    .pr-card-header { display: flex; align-items: flex-start; gap: 6px; }
    .pr-icon { flex-shrink: 0; width: 16px; height: 16px; margin-top: 2px; }
    .pr-icon svg { width: 16px; height: 16px; }
    .pr-title-wrap { flex: 1; min-width: 0; }
    .pr-title { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pr-repo { font-size: 11px; color: var(--text-secondary); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pr-meta { display: flex; align-items: center; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
    .badge { display: inline-flex; align-items: center; gap: 3px; padding: 1px 6px; border-radius: 10px; font-size: 10px; font-weight: 500; line-height: 16px; }
    .badge svg { width: 12px; height: 12px; }
    .badge-green { background: rgba(63,185,80,0.15); color: var(--green); }
    .badge-red { background: rgba(248,81,73,0.15); color: var(--red); }
    .badge-yellow { background: rgba(210,153,34,0.15); color: var(--yellow); }
    .badge-grey { background: rgba(125,133,144,0.15); color: var(--text-secondary); }
    .badge-purple { background: rgba(188,140,255,0.15); color: var(--purple); }
    .pr-time { font-size: 11px; color: var(--text-secondary); margin-left: auto; flex-shrink: 0; }

    /* Review card extras */
    .review-author { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
    .review-author img { width: 14px; height: 14px; border-radius: 50%; vertical-align: middle; margin-right: 3px; }
    .age-warning { color: var(--yellow); }
    .age-urgent { color: var(--red); }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.6; } }
    .age-urgent { animation: pulse 2s ease-in-out infinite; }

    /* Empty state */
    .panel-empty { padding: 32px 14px; text-align: center; color: var(--text-secondary); font-size: 13px; }

    /* Offline */
    .offline-bar { display: none; padding: 4px 14px; background: rgba(210,153,34,0.15); color: var(--yellow); font-size: 11px; text-align: center; flex-shrink: 0; }
    .offline-bar.visible { display: block; }

    /* Settings button */
    .settings-btn { display: none; position: fixed; top: 8px; right: 8px; width: 28px; height: 28px; background: var(--surface-color); border: 1px solid var(--border-color); border-radius: 6px; cursor: pointer; z-index: 50; align-items: center; justify-content: center; }
    .settings-btn:hover { border-color: var(--accent-color); }
    .settings-btn svg { width: 16px; height: 16px; fill: var(--text-secondary); }

    /* Settings Modal */
    .settings-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 100; align-items: center; justify-content: center; }
    .settings-modal.visible { display: flex; }
    .settings-panel { background: var(--surface-color); border: 1px solid var(--border-color); border-radius: 10px; padding: 20px; width: 90%; max-width: 360px; }
    .settings-panel h3 { margin: 0 0 16px; font-size: 15px; font-weight: 600; }
    .settings-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; font-size: 13px; }
    .settings-row label { color: var(--text-secondary); }
    .settings-row span { color: var(--text-primary); }
    .settings-danger { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border-color); }
    .disconnect-btn { padding: 6px 14px; background: transparent; border: 1px solid var(--red); border-radius: 6px; color: var(--red); font-size: 13px; cursor: pointer; }
    .disconnect-btn:hover { background: rgba(248,81,73,0.1); }
    .settings-close { margin-top: 16px; text-align: center; }
    .settings-close-btn { padding: 6px 20px; background: var(--border-color); border: none; border-radius: 6px; color: var(--text-primary); font-size: 13px; cursor: pointer; }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-secondary); }
  </style>
</head>
<body>

  <div class="loading-state" id="loadingState">
    <div class="spinner"></div>
    <span>Connecting to GitHub...</span>
  </div>

  <div class="setup-state" id="setupState">
    <svg class="setup-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354z"/></svg>
    <div class="setup-title">GitHub PRs</div>
    <div class="setup-hint">Enter a Personal Access Token with <strong>read:user</strong> and <strong>repo</strong> scopes.</div>
    <input type="password" class="pat-input" id="patInput" placeholder="ghp_xxxxxxxxxxxx" autocomplete="off" spellcheck="false">
    <button class="setup-btn" id="setupBtn" onclick="onSetupSubmit()">Connect</button>
    <div class="setup-error" id="setupError"></div>
  </div>

  <div class="error-state" id="errorState">
    <div class="error-msg" id="errorMsg">Something went wrong.</div>
    <button class="error-btn" onclick="onRetry()">Retry</button>
    <button class="error-btn" onclick="onDisconnect()">Change Token</button>
  </div>

  <div class="content-area" id="contentArea">
    <div class="offline-bar" id="offlineBar">Offline — showing cached data</div>
    <div class="header-bar">
      <div class="header-title">Pull Requests</div>
    </div>
    <div class="tab-bar">
      <button class="tab-btn active" id="tabMyPRs" onclick="switchTab('myPRs')">My PRs <span class="tab-badge" id="badgeMyPRs">0</span></button>
      <button class="tab-btn" id="tabReviews" onclick="switchTab('reviews')">Reviews <span class="tab-badge" id="badgeReviews">0</span></button>
      <button class="tab-btn" id="tabConflicts" onclick="switchTab('conflicts')">Conflicts <span class="tab-badge" id="badgeConflicts">0</span></button>
    </div>
    <div class="panel active" id="panelMyPRs"></div>
    <div class="panel" id="panelReviews"></div>
    <div class="panel" id="panelConflicts"></div>
  </div>

  <div class="settings-btn" id="settingsBtn" onclick="openSettings()">
    <svg viewBox="0 0 16 16"><path d="M7.07.65a.85.85 0 0 1 1.86 0l.26 1.54a5.55 5.55 0 0 1 1.36.56l1.3-.85a.85.85 0 0 1 1.16.16l.05.05a.85.85 0 0 1 .1 1.11l-.84 1.3c.24.43.43.89.56 1.37l1.54.25a.85.85 0 0 1 0 1.86l-1.54.26a5.55 5.55 0 0 1-.56 1.36l.85 1.3a.85.85 0 0 1-.16 1.16l-.05.05a.85.85 0 0 1-1.11.1l-1.3-.84a5.55 5.55 0 0 1-1.37.56l-.25 1.54a.85.85 0 0 1-1.86 0l-.26-1.54a5.55 5.55 0 0 1-1.36-.56l-1.3.85a.85.85 0 0 1-1.16-.16l-.05-.05a.85.85 0 0 1-.1-1.11l.84-1.3a5.55 5.55 0 0 1-.56-1.37l-1.54-.25a.85.85 0 0 1 0-1.86l1.54-.26a5.55 5.55 0 0 1 .56-1.36l-.85-1.3a.85.85 0 0 1 .16-1.16l.05-.05a.85.85 0 0 1 1.11-.1l1.3.84a5.55 5.55 0 0 1 1.37-.56L7.07.65zM8 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/></svg>
  </div>

  <div class="settings-modal" id="settingsModal" onclick="if(event.target.id==='settingsModal')closeSettings()">
    <div class="settings-panel">
      <h3>Settings</h3>
      <div class="settings-row"><label>Account</label><span id="settingsLogin">—</span></div>
      <div class="settings-row"><label>Refresh interval</label><span id="settingsRefresh">3 min</span></div>
      <div class="settings-row"><label>Last updated</label><span id="settingsLastUpdate">—</span></div>
      <div class="settings-danger"><button class="disconnect-btn" onclick="onDisconnect()">Disconnect Token</button></div>
      <div class="settings-close"><button class="settings-close-btn" onclick="closeSettings()">Close</button></div>
    </div>
  </div>

<script>
  var PAT_KEY = 'gh_prs_pat';
  var CACHE_KEY = 'gh_prs_cache';
  var GQL_URL = 'https://api.github.com/graphql';

  var PR_QUERY_TPL = 'query($login:String!,$searchQ:String!){user(login:$login){pullRequests(states:OPEN,first:50,orderBy:{field:UPDATED_AT,direction:DESC}){totalCount nodes{title url number createdAt updatedAt repository{nameWithOwner}isDraft mergeable reviewDecision commits(last:1){nodes{commit{statusCheckRollup{state}}}}}}}search(query:$searchQ,type:ISSUE,first:50){issueCount edges{node{...on PullRequest{title url number createdAt repository{nameWithOwner}author{login avatarUrl}isDraft mergeable reviewDecision}}}}}';

  var state = {
    pat: null, login: null, lastFetch: 0,
    rateLimitRemaining: null, rateLimitReset: null,
    pollTimerId: null, activeTab: 'myPRs',
    cachedData: null
  };

  // Storage
  function loadPAT() { try { return localStorage.getItem(PAT_KEY); } catch(e) { return null; } }
  function savePAT(p) { try { localStorage.setItem(PAT_KEY, p); } catch(e) {} }
  function clearPAT() { try { localStorage.removeItem(PAT_KEY); } catch(e) {} }
  function loadCache() {
    try {
      var r = localStorage.getItem(CACHE_KEY);
      if (!r) return null;
      var p = JSON.parse(r);
      if (Date.now() - p.timestamp > 3600000) return null;
      return p.data;
    } catch(e) { return null; }
  }
  function saveCache(d) {
    try { localStorage.setItem(CACHE_KEY, JSON.stringify({ timestamp: Date.now(), data: d })); }
    catch(e) {}
  }

  // API
  async function graphqlQuery(query, variables) {
    var resp = await fetch(GQL_URL, {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + state.pat, 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: query, variables: variables || {} })
    });
    var rem = resp.headers.get('x-ratelimit-remaining');
    var rst = resp.headers.get('x-ratelimit-reset');
    if (rem !== null) state.rateLimitRemaining = parseInt(rem, 10);
    if (rst !== null) state.rateLimitReset = parseInt(rst, 10);
    if (resp.status === 401) throw new Error('TOKEN_INVALID');
    if (resp.status === 403) throw new Error('RATE_LIMITED');
    if (!resp.ok) throw new Error('API_ERROR_' + resp.status);
    var json = await resp.json();
    if (json.errors && json.errors.length > 0) throw new Error('GRAPHQL_ERROR: ' + (json.errors[0].message || 'Unknown'));
    return json.data;
  }

  // Helpers
  function getRefreshInterval() { return (typeof refreshInterval !== 'undefined') ? (parseInt(refreshInterval,10)||3) : 3; }
  function getShowDrafts() { return (typeof showDrafts !== 'undefined') ? showDrafts !== 'Hide' : true; }
  function relativeTime(ds) {
    var s = Math.floor((Date.now() - new Date(ds).getTime()) / 1000);
    if (s < 60) return 'just now';
    var m = Math.floor(s/60); if (m < 60) return m+'m ago';
    var h = Math.floor(m/60); if (h < 24) return h+'h ago';
    var d = Math.floor(h/24); if (d < 30) return d+'d ago';
    return Math.floor(d/30)+'mo ago';
  }
  function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function ageHours(ds) { return (Date.now() - new Date(ds).getTime()) / 3600000; }

  // UI state
  function showState(name) {
    document.getElementById('loadingState').style.display = name === 'loading' ? '' : 'none';
    document.getElementById('setupState').style.display = name === 'setup' ? 'flex' : 'none';
    document.getElementById('errorState').style.display = name === 'error' ? 'flex' : 'none';
    document.getElementById('contentArea').style.display = name === 'content' ? 'flex' : 'none';
    document.getElementById('settingsBtn').style.display = name === 'content' ? 'flex' : 'none';
  }
  function showSetupError(msg) { var el = document.getElementById('setupError'); el.textContent = msg; el.style.display = msg ? '' : 'none'; }
  function showError(msg) { document.getElementById('errorMsg').textContent = msg; showState('error'); }

  // Tabs
  function switchTab(name) {
    state.activeTab = name;
    var map = { myPRs: 'MyPRs', reviews: 'Reviews', conflicts: 'Conflicts' };
    for (var key in map) {
      document.getElementById('tab' + map[key]).classList.toggle('active', key === name);
      document.getElementById('panel' + map[key]).classList.toggle('active', key === name);
    }
  }

  // SVG icons
  var IC = {
    prOpen: '<svg viewBox="0 0 16 16" fill="var(--green)"><path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354z"/></svg>',
    prDraft: '<svg viewBox="0 0 16 16" fill="var(--text-secondary)"><path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354z"/></svg>',
    check: '<svg viewBox="0 0 16 16" fill="currentColor"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg>',
    x: '<svg viewBox="0 0 16 16" fill="currentColor"><path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.75.75 0 1 1 1.06 1.06L9.06 8l3.22 3.22a.75.75 0 1 1-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 0 1-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06z"/></svg>',
    dot: '<svg viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="4"/></svg>',
    conflict: '<svg viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 12.5a.75.75 0 0 1-.75-.75V8a.75.75 0 0 1 1.5 0v3.75a.75.75 0 0 1-.75.75zm5 0a.75.75 0 0 1-.75-.75V8a.75.75 0 0 1 1.5 0v3.75a.75.75 0 0 1-.75.75zM5.5 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm5 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/></svg>'
  };

  // Render
  function getCheckBadge(pr) {
    var c = pr.commits && pr.commits.nodes && pr.commits.nodes[0] && pr.commits.nodes[0].commit;
    if (!c || !c.statusCheckRollup) return '';
    var s = c.statusCheckRollup.state;
    if (s === 'SUCCESS') return '<span class="badge badge-green">' + IC.check + ' Passing</span>';
    if (s === 'FAILURE' || s === 'ERROR') return '<span class="badge badge-red">' + IC.x + ' Failing</span>';
    if (s === 'PENDING') return '<span class="badge badge-yellow">' + IC.dot + ' Pending</span>';
    return '';
  }

  function getReviewBadge(pr) {
    var rd = pr.reviewDecision;
    if (rd === 'APPROVED') return '<span class="badge badge-green">' + IC.check + ' Approved</span>';
    if (rd === 'CHANGES_REQUESTED') return '<span class="badge badge-red">' + IC.x + ' Changes</span>';
    if (rd === 'REVIEW_REQUIRED') return '<span class="badge badge-yellow">' + IC.dot + ' Review needed</span>';
    return '';
  }

  function getMergeableBadge(pr) {
    if (pr.mergeable === 'CONFLICTING') return '<span class="badge badge-red">' + IC.conflict + ' Conflicts</span>';
    if (pr.mergeable === 'UNKNOWN') return '<span class="badge badge-grey">Checking...</span>';
    return '';
  }

  function renderMyPRs(prs) {
    var show = getShowDrafts();
    var panel = document.getElementById('panelMyPRs');
    var filtered = [];
    for (var i = 0; i < prs.length; i++) {
      if (!show && prs[i].isDraft) continue;
      filtered.push(prs[i]);
    }
    if (filtered.length === 0) {
      panel.innerHTML = '<div class="panel-empty">No open pull requests</div>';
      return;
    }
    var html = '';
    for (var i = 0; i < filtered.length; i++) {
      var pr = filtered[i];
      var icon = pr.isDraft ? IC.prDraft : IC.prOpen;
      html += '<div class="pr-card"><div class="pr-card-header"><div class="pr-icon">' + icon + '</div><div class="pr-title-wrap"><div class="pr-title">' + escHtml(pr.title) + '</div><div class="pr-repo">' + escHtml(pr.repository.nameWithOwner) + ' #' + pr.number + '</div></div></div><div class="pr-meta">';
      if (pr.isDraft) html += '<span class="badge badge-grey">Draft</span>';
      html += getCheckBadge(pr) + getReviewBadge(pr) + getMergeableBadge(pr);
      html += '<span class="pr-time">' + relativeTime(pr.createdAt) + '</span></div></div>';
    }
    panel.innerHTML = html;
  }

  function renderReviews(reviews) {
    var panel = document.getElementById('panelReviews');
    if (!reviews || reviews.length === 0) {
      panel.innerHTML = '<div class="panel-empty">No pending reviews</div>';
      return;
    }
    var html = '';
    for (var i = 0; i < reviews.length; i++) {
      var pr = reviews[i];
      if (!pr) continue;
      var h = ageHours(pr.createdAt);
      var ageCls = h > 72 ? ' age-urgent' : (h > 24 ? ' age-warning' : '');
      var authorHtml = '';
      if (pr.author) {
        authorHtml = '<div class="review-author">';
        if (pr.author.avatarUrl) authorHtml += '<img src="' + escHtml(pr.author.avatarUrl) + '&s=28" alt="">';
        authorHtml += escHtml(pr.author.login) + '</div>';
      }
      html += '<div class="pr-card"><div class="pr-card-header"><div class="pr-icon">' + IC.prOpen + '</div><div class="pr-title-wrap"><div class="pr-title">' + escHtml(pr.title) + '</div><div class="pr-repo">' + escHtml(pr.repository.nameWithOwner) + ' #' + pr.number + '</div>' + authorHtml + '</div></div><div class="pr-meta">';
      html += getMergeableBadge(pr);
      html += '<span class="pr-time' + ageCls + '">' + relativeTime(pr.createdAt) + '</span></div></div>';
    }
    panel.innerHTML = html;
  }

  function renderConflicts(myPRs, reviews) {
    var panel = document.getElementById('panelConflicts');
    var conflicts = [];
    for (var i = 0; i < myPRs.length; i++) {
      if (myPRs[i].mergeable === 'CONFLICTING') conflicts.push({ pr: myPRs[i], source: 'My PR' });
    }
    for (var i = 0; i < (reviews || []).length; i++) {
      if (reviews[i] && reviews[i].mergeable === 'CONFLICTING') conflicts.push({ pr: reviews[i], source: 'Review' });
    }
    if (conflicts.length === 0) {
      panel.innerHTML = '<div class="panel-empty">No merge conflicts</div>';
      return;
    }
    var html = '';
    for (var i = 0; i < conflicts.length; i++) {
      var c = conflicts[i];
      html += '<div class="pr-card"><div class="pr-card-header"><div class="pr-icon"><svg viewBox="0 0 16 16" fill="var(--red)"><path d="M5.5 12.5a.75.75 0 0 1-.75-.75V8a.75.75 0 0 1 1.5 0v3.75a.75.75 0 0 1-.75.75zm5 0a.75.75 0 0 1-.75-.75V8a.75.75 0 0 1 1.5 0v3.75a.75.75 0 0 1-.75.75zM5.5 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm5 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/></svg></div><div class="pr-title-wrap"><div class="pr-title">' + escHtml(c.pr.title) + '</div><div class="pr-repo">' + escHtml(c.pr.repository.nameWithOwner) + ' #' + c.pr.number + '</div></div></div><div class="pr-meta"><span class="badge badge-red">' + IC.conflict + ' Conflicts</span><span class="badge badge-grey">' + c.source + '</span></div></div>';
    }
    panel.innerHTML = html;
  }

  function updateBadges(myPRs, reviews) {
    var show = getShowDrafts();
    var myCount = 0;
    for (var i = 0; i < myPRs.length; i++) {
      if (!show && myPRs[i].isDraft) continue;
      myCount++;
    }
    var conflictCount = 0;
    for (var i = 0; i < myPRs.length; i++) if (myPRs[i].mergeable === 'CONFLICTING') conflictCount++;
    for (var i = 0; i < (reviews||[]).length; i++) if (reviews[i] && reviews[i].mergeable === 'CONFLICTING') conflictCount++;

    document.getElementById('badgeMyPRs').textContent = myCount;
    document.getElementById('badgeReviews').textContent = (reviews || []).length;
    document.getElementById('badgeConflicts').textContent = conflictCount;
  }

  function renderAll(data) {
    var myPRs = (data.user && data.user.pullRequests) ? data.user.pullRequests.nodes : [];
    var reviewEdges = (data.search && data.search.edges) ? data.search.edges : [];
    var reviews = [];
    for (var i = 0; i < reviewEdges.length; i++) {
      if (reviewEdges[i].node) reviews.push(reviewEdges[i].node);
    }
    renderMyPRs(myPRs);
    renderReviews(reviews);
    renderConflicts(myPRs, reviews);
    updateBadges(myPRs, reviews);
  }

  // Fetch
  async function fetchPRData() {
    return await graphqlQuery(PR_QUERY_TPL, {
      login: state.login,
      searchQ: 'is:open is:pr review-requested:' + state.login
    });
  }

  async function fetchAndRender() {
    try {
      var data = await fetchPRData();
      state.lastFetch = Date.now();
      state.cachedData = data;
      renderAll(data);
      saveCache(data);
      document.getElementById('offlineBar').classList.remove('visible');
    } catch (err) {
      handleFetchError(err);
    }
  }

  function handleFetchError(err) {
    var msg = err.message || '';
    if (msg === 'TOKEN_INVALID') {
      clearPAT(); state.pat = null; stopPolling();
      showSetupError('Token expired or revoked. Enter a new token.');
      showState('setup');
    } else if (msg === 'RATE_LIMITED') {
      document.getElementById('offlineBar').textContent = 'Rate limited — showing cached data';
      document.getElementById('offlineBar').classList.add('visible');
    } else {
      document.getElementById('offlineBar').classList.add('visible');
    }
  }

  // Polling
  function startPolling() { stopPolling(); state.pollTimerId = setInterval(fetchAndRender, getRefreshInterval() * 60000); }
  function stopPolling() { if (state.pollTimerId) clearInterval(state.pollTimerId); state.pollTimerId = null; }

  // Setup
  async function onSetupSubmit() {
    var input = document.getElementById('patInput');
    var btn = document.getElementById('setupBtn');
    var pat = input.value.trim();
    if (!pat) { showSetupError('Please enter a token.'); return; }
    btn.disabled = true; btn.textContent = 'Validating...'; showSetupError('');
    state.pat = pat;
    try {
      var vd = await graphqlQuery('{ viewer { login } }');
      state.login = vd.viewer.login;
      savePAT(pat);
      document.getElementById('settingsLogin').textContent = '@' + state.login;
      var data = await fetchPRData();
      state.lastFetch = Date.now(); state.cachedData = data;
      renderAll(data); saveCache(data);
      showState('content'); startPolling();
    } catch (err) {
      state.pat = null;
      var m = err.message || '';
      if (m === 'TOKEN_INVALID') showSetupError('Invalid token. Check scopes and try again.');
      else if (m === 'RATE_LIMITED') showSetupError('Rate limited. Try again in a few minutes.');
      else showSetupError('Connection failed. Check network.');
    } finally { btn.disabled = false; btn.textContent = 'Connect'; }
  }

  function onRetry() { startApp(); }
  function onDisconnect() {
    stopPolling(); state.pat = null; state.login = null; clearPAT(); closeSettings();
    document.getElementById('patInput').value = ''; showSetupError(''); showState('setup');
  }

  // Settings
  function openSettings() {
    document.getElementById('settingsRefresh').textContent = getRefreshInterval() + ' min';
    document.getElementById('settingsLastUpdate').textContent = state.lastFetch ? new Date(state.lastFetch).toLocaleTimeString() : '—';
    document.getElementById('settingsModal').classList.add('visible');
  }
  function closeSettings() { document.getElementById('settingsModal').classList.remove('visible'); }

  // iCUE
  function applyStyles() {
    var root = document.documentElement;
    var t = Number(typeof transparency !== 'undefined' ? transparency : 100);
    root.style.setProperty('--transparency', Number.isFinite(t) ? t / 100 : 1);
    root.style.setProperty('--text-primary', typeof textColor !== 'undefined' ? textColor : '#e6edf3');
    root.style.setProperty('--accent-color', typeof accentColor !== 'undefined' ? accentColor : '#58a6ff');
    root.style.setProperty('--bg-color', typeof backgroundColor !== 'undefined' ? backgroundColor : '#0d1117');
  }
  function onIcueDataUpdated() {
    applyStyles();
    if (state.cachedData) renderAll(state.cachedData);
  }
  function onIcueInitialized() { onIcueDataUpdated(); startApp(); }

  // Startup
  async function startApp() {
    var pat = loadPAT();
    if (!pat) { showState('setup'); return; }
    state.pat = pat;
    var cached = loadCache();
    if (cached) {
      try {
        var vd = await graphqlQuery('{ viewer { login } }');
        state.login = vd.viewer.login;
      } catch(e) { state.login = ''; }
      state.cachedData = cached;
      renderAll(cached);
      document.getElementById('settingsLogin').textContent = state.login ? '@' + state.login : '—';
      showState('content');
    } else {
      showState('loading');
    }
    try {
      if (!state.login) {
        var vd = await graphqlQuery('{ viewer { login } }');
        state.login = vd.viewer.login;
        document.getElementById('settingsLogin').textContent = '@' + state.login;
      }
      var data = await fetchPRData();
      state.lastFetch = Date.now(); state.cachedData = data;
      renderAll(data); saveCache(data);
      showState('content'); startPolling();
    } catch (err) {
      var m = err.message || '';
      if (m === 'TOKEN_INVALID') {
        clearPAT(); state.pat = null;
        showSetupError('Token expired or revoked. Enter a new token.'); showState('setup');
      } else if (cached) {
        document.getElementById('offlineBar').classList.add('visible'); startPolling();
      } else { showError('Network error. Check connection.'); }
    }
  }

  if (typeof window !== 'undefined') {
    window.icueEvents = { 'onDataUpdated': onIcueDataUpdated, 'onICUEInitialized': onIcueInitialized };
  }
  if (typeof iCUE_initialized !== 'undefined' && iCUE_initialized) { onIcueInitialized(); }
  else { applyStyles(); startApp(); }

  document.getElementById('patInput').addEventListener('keydown', function(e) { if (e.key === 'Enter') onSetupSubmit(); });
</script>
</body>
</html>
