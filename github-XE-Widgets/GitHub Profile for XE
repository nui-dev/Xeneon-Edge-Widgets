  </div>

  <!-- Content -->
  <div class="content-area" id="contentArea">
    <div class="offline-bar" id="offlineBar">Offline — showing cached data</div>
    <div class="header-bar" id="headerBar">
      <img class="avatar" id="avatarImg" src="" alt="">
      <div class="avatar-fallback" id="avatarFallback"></div>
      <div class="header-info">
        <div class="header-name" id="headerName">—</div>
        <div class="header-login" id="headerLogin">—</div>
      </div>
    </div>
    <div class="stats-grid" id="statsGrid"></div>
    <div class="contrib-section" id="contribSection">
      <div class="contrib-header">
        <span class="contrib-title">Contributions</span>
        <span class="contrib-total" id="contribTotal"></span>
      </div>
      <div class="contrib-months" id="contribMonths"></div>
      <div class="contrib-graph-wrap">
        <div class="contrib-graph" id="contribGraph"></div>
      </div>
      <div class="contrib-streak" id="contribStreak"></div>
    </div>
    <div class="activity-section" id="activitySection">
      <div class="activity-header">Recent Activity</div>
      <div id="activityList"></div>
    </div>
  </div>

  <!-- Settings Button -->
  <div class="settings-btn" id="settingsBtn" onclick="openSettings()">
    <svg viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/><path d="M7.07.65a.85.85 0 0 1 1.86 0l.26 1.54a5.55 5.55 0 0 1 1.36.56l1.3-.85a.85.85 0 0 1 1.16.16l.05.05a.85.85 0 0 1 .1 1.11l-.84 1.3c.24.43.43.89.56 1.37l1.54.25a.85.85 0 0 1 0 1.86l-1.54.26a5.55 5.55 0 0 1-.56 1.36l.85 1.3a.85.85 0 0 1-.16 1.16l-.05.05a.85.85 0 0 1-1.11.1l-1.3-.84a5.55 5.55 0 0 1-1.37.56l-.25 1.54a.85.85 0 0 1-1.86 0l-.26-1.54a5.55 5.55 0 0 1-1.36-.56l-1.3.85a.85.85 0 0 1-1.16-.16l-.05-.05a.85.85 0 0 1-.1-1.11l.84-1.3a5.55 5.55 0 0 1-.56-1.37l-1.54-.25a.85.85 0 0 1 0-1.86l1.54-.26a5.55 5.55 0 0 1 .56-1.36l-.85-1.3a.85.85 0 0 1 .16-1.16l.05-.05a.85.85 0 0 1 1.11-.1l1.3.84a5.55 5.55 0 0 1 1.37-.56L7.07.65zM8 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/></svg>
