  ]
  </script>

  <style>
    :root {
      --bg-color: #0d1117;
      --surface-color: #161b22;
      --border-color: #30363d;
      --text-primary: #e6edf3;
      --text-secondary: #7d8590;
      --accent-color: #58a6ff;
      --green: #3fb950;
      --red: #f85149;
      --yellow: #d29922;
      --purple: #bc8cff;
      --transparency: 1;
      --contrib-empty: #161b22;
      --contrib-l1: #0e4429;
      --contrib-l2: #006d32;
      --contrib-l3: #26a641;
      --contrib-l4: #39d353;
    }

    html { overflow: hidden; }

    body {
      margin: 0; padding: 0;
      width: 100vw; height: 100vh;
      display: flex; align-items: center; justify-content: center;
      background: var(--bg-color);
      color: var(--text-primary);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      font-size: 14px;
      opacity: var(--transparency);
      overflow: hidden;
      -webkit-user-select: none; user-select: none;
    }

    *, *::before, *::after { box-sizing: border-box; }

    /* Loading State */
    .loading-state {
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 16px; height: 100vh; width: 100vw;
    }
    .spinner {
      width: 32px; height: 32px;
      border: 3px solid var(--border-color);
      border-top-color: var(--accent-color);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .loading-state span { color: var(--text-secondary); font-size: 13px; }

    /* Setup State */
    .setup-state {
      display: none; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 16px; height: 100vh; width: 100vw;
      padding: 24px;
    }
    .setup-icon {
      width: 48px; height: 48px;
      opacity: 0.7;
    }
    .setup-title {
      font-size: 18px; font-weight: 600;
      color: var(--text-primary);
    }
    .setup-hint {
      font-size: 12px; color: var(--text-secondary);
      text-align: center; max-width: 320px; line-height: 1.5;
    }
    .pat-input {
      width: 100%; max-width: 340px;
      padding: 10px 12px;
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      color: var(--text-primary);
      font-size: 14px; font-family: monospace;
      outline: none;
    }
    .pat-input:focus { border-color: var(--accent-color); }
    .pat-input::placeholder { color: var(--text-secondary); }
    .setup-btn {
      padding: 8px 24px;
      background: var(--green);
      color: #ffffff; font-weight: 600; font-size: 14px;
      border: none; border-radius: 6px;
      cursor: pointer;
    }
    .setup-btn:hover { opacity: 0.9; }
    .setup-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .setup-error {
      color: var(--red); font-size: 13px;
      display: none; text-align: center;
    }

    /* Error State */
    .error-state {
      display: none; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 12px; height: 100vh; width: 100vw;
      padding: 24px;
    }
    .error-msg {
      color: var(--text-secondary); font-size: 14px;
      text-align: center; max-width: 300px;
    }
    .error-btn {
      padding: 6px 16px;
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      color: var(--text-primary); font-size: 13px;
      cursor: pointer;
    }
    .error-btn:hover { border-color: var(--accent-color); }

    /* Content Area */
    .content-area {
      display: none; flex-direction: column;
      width: 100vw; height: 100vh;
      overflow: hidden;
    }

    /* Settings button */
    .settings-btn {
      display: none;
      position: fixed; top: 8px; right: 8px;
      width: 28px; height: 28px;
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      cursor: pointer; z-index: 50;
      align-items: center; justify-content: center;
    }
    .settings-btn:hover { border-color: var(--accent-color); }
    .settings-btn svg { width: 16px; height: 16px; fill: var(--text-secondary); }

    /* Settings Modal */
    .settings-modal {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.7);
      z-index: 100;
      align-items: center; justify-content: center;
    }
    .settings-modal.visible { display: flex; }
    .settings-panel {
      background: var(--surface-color);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 20px; width: 90%; max-width: 360px;
    }
    .settings-panel h3 {
      margin: 0 0 16px; font-size: 15px; font-weight: 600;
    }
    .settings-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 0; font-size: 13px;
    }
    .settings-row label { color: var(--text-secondary); }
    .settings-row span { color: var(--text-primary); }
    .settings-danger {
      margin-top: 16px; padding-top: 16px;
      border-top: 1px solid var(--border-color);
    }
    .disconnect-btn {
      padding: 6px 14px;
      background: transparent;
      border: 1px solid var(--red);
      border-radius: 6px;
      color: var(--red); font-size: 13px;
      cursor: pointer;
    }
    .disconnect-btn:hover { background: rgba(248,81,73,0.1); }
    .settings-close {
      margin-top: 16px; text-align: center;
    }
    .settings-close-btn {
      padding: 6px 20px;
      background: var(--border-color);
      border: none; border-radius: 6px;
      color: var(--text-primary); font-size: 13px;
      cursor: pointer;
    }

    /* Header Bar */
    .header-bar {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; flex-shrink: 0;
      border-bottom: 1px solid var(--border-color);
    }
    .avatar {
      width: 32px; height: 32px; border-radius: 50%;
      border: 1px solid var(--border-color);
    }
    .avatar-fallback {
      display: none; width: 32px; height: 32px; border-radius: 50%;
      background: var(--border-color);
      align-items: center; justify-content: center;
      font-size: 14px; font-weight: 600; color: var(--text-primary);
    }
    .header-info { flex: 1; min-width: 0; }
    .header-name {
      font-size: 14px; font-weight: 600;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .header-login {
      font-size: 12px; color: var(--text-secondary);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* Stats Grid */
    .stats-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1px; background: var(--border-color);
      flex-shrink: 0;
    }
    .stat-card {
      background: var(--surface-color);
      padding: 8px 10px;
      text-align: center;
    }
    .stat-value {
      font-size: 16px; font-weight: 700;
      color: var(--text-primary);
    }
    .stat-label {
      font-size: 10px; color: var(--text-secondary);
      margin-top: 2px; text-transform: uppercase; letter-spacing: 0.5px;
    }

    /* Contribution Graph */
    .contrib-section {
      flex-shrink: 0; padding: 10px 14px;
      border-bottom: 1px solid var(--border-color);
    }
    .contrib-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 8px;
    }
    .contrib-title {
      font-size: 12px; color: var(--text-secondary);
    }
    .contrib-total {
      font-size: 12px; color: var(--text-secondary);
    }
    .contrib-total strong { color: var(--text-primary); font-weight: 600; }
    .contrib-graph-wrap {
      overflow-x: auto; overflow-y: hidden;
      padding-bottom: 4px;
    }
    .contrib-graph {
      display: grid;
      grid-template-rows: repeat(7, 1fr);
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 2px;
      min-width: fit-content;
    }
    .contrib-cell {
      width: 10px; height: 10px;
      border-radius: 2px;
      background: var(--contrib-empty);
    }
    .contrib-months {
      display: flex; gap: 0; margin-bottom: 4px;
      font-size: 9px; color: var(--text-secondary);
    }
    .contrib-month { text-align: left; }
    .contrib-streak {
      margin-top: 6px; font-size: 11px; color: var(--text-secondary);
    }
    .contrib-streak strong { color: var(--text-primary); }

    /* Activity Feed */
    .activity-section {
      flex: 1; overflow-y: auto;
      padding: 0;
    }
    .activity-header {
      padding: 8px 14px; font-size: 12px; color: var(--text-secondary);
      border-bottom: 1px solid var(--border-color);
      position: sticky; top: 0;
      background: var(--bg-color); z-index: 2;
    }
    .activity-item {
      display: flex; align-items: flex-start; gap: 8px;
      padding: 8px 14px;
      border-bottom: 1px solid var(--border-color);
      font-size: 12px; line-height: 1.4;
    }
    .activity-icon {
      flex-shrink: 0; width: 16px; height: 16px; margin-top: 1px;
    }
    .activity-icon svg { width: 16px; height: 16px; }
    .activity-text { flex: 1; min-width: 0; }
    .activity-repo {
      color: var(--accent-color); font-weight: 500;
    }
    .activity-time {
      flex-shrink: 0; font-size: 11px; color: var(--text-secondary);
      margin-top: 1px;
    }
    .activity-empty {
      padding: 24px 14px; text-align: center;
      color: var(--text-secondary); font-size: 13px;
    }

    /* Offline indicator */
    .offline-bar {
      display: none; padding: 4px 14px;
      background: rgba(210,153,34,0.15);
      color: var(--yellow); font-size: 11px;
      text-align: center; flex-shrink: 0;
    }
    .offline-bar.visible { display: block; }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-secondary); }
  </style>
</head>
<body>

  <!-- Loading -->
  <div class="loading-state" id="loadingState">
    <div class="spinner"></div>
    <span>Connecting to GitHub...</span>
  </div>

  <!-- Setup -->
  <div class="setup-state" id="setupState">
    <svg class="setup-icon" viewBox="0 0 16 16" fill="currentColor">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
    </svg>
    <div class="setup-title">GitHub Profile</div>
    <div class="setup-hint">
      Enter a Personal Access Token with <strong>read:user</strong> and <strong>repo</strong> scopes to get started.
    </div>
    <input type="password" class="pat-input" id="patInput" placeholder="ghp_xxxxxxxxxxxx" autocomplete="off" spellcheck="false">
    <button class="setup-btn" id="setupBtn" onclick="onSetupSubmit()">Connect</button>
